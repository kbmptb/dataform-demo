config {
    type: "table",
    schema: "dataflow_demo_dev",
    name: "best_customers"
}

SELECT
  customer_id,
  count_order_id,
  sum_amount
FROM (
  SELECT
    customer_id,
    COUNT(order_id) count_order_id,
    SUM(amount) sum_amount,
    ROW_NUMBER() OVER (ORDER BY SUM(amount) DESC ) AS numero_ligne
  FROM
    `project-a0c99e7b-8c47-4075-b97.dataflow_demo_dev.orders_enriched`
  GROUP BY
    customer_id
  QUALIFY
    numero_ligne <= 10
  ORDER BY
    SUM(amount) DESC )
